# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/nutriguard"

# Security
JWT_SECRET="super-secret-key-change-this-in-production"

# Server Configuration
PORT=3000

# Email (SMTP) Configuration
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-specific-password"

# Python Prediction Configuration
# On Render, set PYTHON_PATH to "python3"
# On Render, set PYTHON_SCRIPT_PATH to "../predict.py"
PYTHON_PATH="python3"
PYTHON_SCRIPT_PATH="../predict.py"
